api:
  insecure: true
  dashboard: true

providers:
  http:
    endpoint: "http://pangolin:3001/api/v1/traefik-config"
    pollInterval: "5s"

  file:
    filename: "/etc/traefik/dynamic_config.yml"
    watch: true

experimental:
  plugins:
    badger:
      moduleName: "github.com/fosrl/badger"
      version: "{{ pangolin_badger_version }}"
    crowdsec:
      moduleName: "github.com/maxlerebourg/crowdsec-bouncer-traefik-plugin"
      version: "{{ pangolin_crowdsec_plugin_version }}"

accessLog:
  filePath: /var/log/traefik/access.log
  format: json

log:
  level: INFO
  format: common

certificatesResolvers:
  letsencrypt:
    acme:
      httpChallenge:
        entryPoint: web
      email: "{{ pangolin_letsencrypt_email }}"
      storage: /letsencrypt/acme.json

entryPoints:
  web:
    address: ":80"

  websecure:
    address: ":443"
    transport:
      respondingTimeouts:
        readTimeout: "30m"
    http:
      middlewares:
        - crowdsec@file
      tls:
        certResolver: letsencrypt

serversTransport:
  insecureSkipVerify: false

ping:
  entryPoint: web