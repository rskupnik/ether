[Unit]
Description=Pangolin subnet router
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=root
Group=root
EnvironmentFile=/etc/pangolin/client.env
ExecStart=/bin/sh -c 'exec {{ pangolin_cli_binary }} up client --id "$PANGOLIN_CLIENT_ID" --secret "$PANGOLIN_CLIENT_SECRET" --endpoint "$PANGOLIN_ENDPOINT" --subnet-router --attach'
Restart=always
RestartSec=5
UMask=0077

[Install]
WantedBy=multi-user.target
