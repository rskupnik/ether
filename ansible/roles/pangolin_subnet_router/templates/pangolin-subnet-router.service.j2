[Unit]
Description=Pangolin LAN Subnet Router
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=root
Group=root
ExecStart={{ pangolin_cli_binary }} up client --id {{ pangolin_machine_id }} --secret {{ pangolin_machine_secret }} --endpoint {{ pangolin_cli_endpoint }} --subnet-router --attach
Restart=always
RestartSec=10
UMask=0077

[Install]
WantedBy=multi-user.target
